# The username (usually your email) and password you sign in to EduPage with.
EDUPAGE_USERNAME=you@example.com
EDUPAGE_PASSWORD=your-edupage-password

# Optional. Schools to use, as the part before .edupage.org, comma-separated.
# Leave unset to discover every school a parent account reaches.
# EDUPAGE_SUBDOMAINS=myschool,otherschool

# Optional. IANA timezone that "today" is judged in. Defaults to Europe/Bratislava.
# EDUPAGE_TIMEZONE=Europe/Bratislava

# Optional. "true" hides send_message and order_meal, so nothing can be changed.
# EDUPAGE_READ_ONLY=true

# Optional. Keep EduPage sessions in this file (mode 600) so a login that needed
# a second factor survives restarts.
# EDUPAGE_SESSION_FILE=~/.local/state/edupage-mcp/sessions.json

# --- Only for `--transport http` (e.g. running on a Raspberry Pi) ------------
# deploy/install.sh writes these for you into /etc/edupage-mcp.env.
# For `docker compose up`, only MCP_AUTH_TOKEN is needed (uncommented).
# MCP_HOST=0.0.0.0            # bind address; default 127.0.0.1
# MCP_PORT=8766
# MCP_AUTH_TOKEN=             # required unless bound to loopback; openssl rand -hex 32
# MCP_ALLOWED_HOSTS=          # optional Host-header allowlist, e.g. pi.local:8766
